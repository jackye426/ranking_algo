# For a fresh checkout, copy to .env.local. Do not overwrite configured secrets.
# Never commit .env.local or send credentials to the browser.
DEMO_DATA_SOURCE=public-profile-snapshot
SERVER_PORT=3000
HOST=127.0.0.1

# Direct local listener: leave proxy trust disabled and public origins unset.
TRUST_PROXY=0
# Behind Railway's single reverse-proxy hop, set TRUST_PROXY=1 and HOST=0.0.0.0.
# Allow only exact browser origins; PUBLIC_ORIGINS adds a comma-separated list.
# The custom origin stays primary while its DNS is pending.
# PUBLIC_ORIGIN=https://search.docmap.co.uk
# PUBLIC_ORIGINS=https://docmap-search-production.up.railway.app
# Hostname creation alone does not confirm deployment readiness.
# Railway supplies PORT; do not put credentials in build arguments.

# The current workspace is configured for the audited DocMap reader in .env.local.
# For another machine, securely transfer the read token or rotate and redeploy it.
# DEMO_DATA_SOURCE=supabase
# SUPABASE_URL=https://PROJECT_REF.supabase.co
# SUPABASE_READER_FUNCTION=docmap-spire-demo-read
# SUPABASE_READER_TOKEN=SERVER_ONLY_64_CHARACTER_HEX_TOKEN

# Clinical requests use AI interpretation; simple filter changes stay local.
# Explanation generation starts only when a user opens a match explanation.
# BM25, embeddings, filtering and evidence preparation remain local.
# OpenRouter is preferred when its key is present. Never expose keys to public/.
# OPENROUTER_API_KEY=
# OPENROUTER_QUERY_MODEL=deepseek/deepseek-v3.2
# OPENROUTER_EXPLANATION_MODEL=deepseek/deepseek-v3.2

# Optional direct OpenAI configuration, used only if the OpenRouter key is absent.
# OPENAI_API_KEY=
# OPENAI_EXPLANATION_MODEL=gpt-4.1-mini
# No key: a clearly labelled Profile evidence fallback is shown.
# Provider errors also show source evidence; they do not switch paid providers.
