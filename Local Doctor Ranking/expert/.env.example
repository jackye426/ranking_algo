# EXPERT_OPENROUTER_PROVIDER=friendli
PORT=3100
HOST=127.0.0.1
# Production only: PUBLIC_ORIGIN=https://your-expert-preview.up.railway.app
# A dedicated writable volume: EXPERT_CACHE_DIR=/data/expert
# Explicitly refresh source data on startup: EXPERT_REFRESH_DATA=1
